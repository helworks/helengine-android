<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x00400000" android:required="true" />
    <application android:label="${helengineLabel}"
                 android:hasCode="false"
                 android:allowBackup="false"
                 android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name="android.app.NativeActivity"
                  android:exported="true"
                  android:screenOrientation="${helengineOrientation}"
                  android:configChanges="orientation|keyboardHidden|screenSize|density">
            <meta-data android:name="android.app.lib_name" android:value="helengine_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
