# Captures the fixed debug player's native ATrace scopes alongside CPU scheduling.
# Record explicitly on Android 9+ with Perfetto; this file does not start a capture.
duration_ms: 10000
buffers {
    size_kb: 32768
    fill_policy: RING_BUFFER
}
data_sources {
    config {
        name: "linux.ftrace"
        ftrace_config {
            ftrace_events: "sched/sched_switch"
            ftrace_events: "sched/sched_wakeup"
            atrace_categories: "gfx"
            atrace_categories: "view"
            atrace_categories: "input"
            atrace_apps: "com.helengine.android.scaffold"
        }
    }
}
data_sources {
    config {
        name: "linux.process_stats"
        process_stats_config {
            scan_all_processes_on_start: true
        }
    }
}
